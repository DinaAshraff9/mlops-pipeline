{
  "title": "MLOps Pipeline Dashboard",
  "uid": "mlops-main",
  "tags": ["mlops", "production"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "🎯 Predictions Per Second",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(mlops_predictions_total[1m])",
        "legendFormat": "{{ result }}"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 2,
      "title": "⚡ P50 / P95 / P99 Latency",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(mlops_prediction_latency_seconds_bucket[5m])) * 1000",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(mlops_prediction_latency_seconds_bucket[5m])) * 1000",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(mlops_prediction_latency_seconds_bucket[5m])) * 1000",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "id": 3,
      "title": "🤖 Model Accuracy",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 6 },
      "targets": [{
        "expr": "mlops_model_accuracy * 100",
        "legendFormat": "Accuracy %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "steps": [
              { "value": 0,  "color": "red"    },
              { "value": 70, "color": "yellow" },
              { "value": 85, "color": "green"  }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "🔄 Active Requests",
      "type": "stat",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 6 },
      "targets": [{
        "expr": "mlops_active_requests",
        "legendFormat": "Active"
      }]
    },
    {
      "id": 5,
      "title": "📊 Total Predictions (24h)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 6 },
      "targets": [{
        "expr": "increase(mlops_predictions_total[24h])",
        "legendFormat": "Total"
      }],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 6,
      "title": "❌ Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(mlops_predictions_total{result='error'}[5m]) / rate(mlops_predictions_total[5m]) * 100",
        "legendFormat": "Error %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 1, "color": "yellow" },
              { "value": 5, "color": "red" }
            ]
          }
        }
      }
    }
  ],
  "schemaVersion": 39
}
